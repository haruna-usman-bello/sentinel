# Postgres connection used by Prisma and the Better Auth adapter.
DATABASE_URL="postgresql://user:password@localhost:5432/sentinel"

# Password every seeded account starts with (default: password123).
# SEED_PASSWORD=""

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
