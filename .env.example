# Postgres connection used by Prisma and the Better Auth adapter.
DATABASE_URL="postgresql://user:password@localhost:5432/sentinel"

# Only where DATABASE_URL goes through a connection pooler, as it does on most
# managed Postgres. Migrations need a session, which a transaction pooler will
# not give, so point this at the database itself.
# DIRECT_URL=""

# Password every seeded account starts with (default: password123).
# SEED_PASSWORD=""

# DHIS2. Without these the app runs on whatever case counts the database
# already holds: the scheduled cycle skips the pull and re-runs detection.
DHIS2_BASE_URL=""
DHIS2_USERNAME=""
DHIS2_PASSWORD=""

# Shared secret for POST /api/jobs/ingest, the scheduled monthly cycle.
CRON_SECRET=""

# Alert delivery. Each channel is independent; without them alerts are still
# raised and recorded, and the notifications screen says plainly that nothing
# is leaving the system. Anything waiting goes out once a channel is set.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# RESEND_API_KEY=""
# ALERT_FROM_EMAIL=""

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The address people actually reach the app at — required wherever that is
# not localhost. On Vercel, set it to the production alias or custom domain:
# the per-deployment hostname is trusted automatically, but the stable one is
# not, and sign-in is refused as cross-origin without this.
BETTER_AUTH_URL="http://localhost:3000"

# The first administrator, for `npm run db:bootstrap` against a fresh
# database. Needed once; every other account is made from the app. Pass them
# on the command line rather than storing them.
# ADMIN_NAME=""
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# Diseases to put under surveillance at bootstrap (default: Cholera,Measles).
# BOOTSTRAP_DISEASES=""
