# Postgres connection used by Prisma and the Better Auth adapter.
DATABASE_URL="postgresql://user:password@localhost:5432/sentinel"

# Only where DATABASE_URL goes through a connection pooler, as it does on most
# managed Postgres. Migrations need a session, which a transaction pooler will
# not give, so point this at the database itself.
# DIRECT_URL=""

# Password every seeded account starts with (default: password123).
# SEED_PASSWORD=""

# DHIS2. Without these the app runs on whatever case counts the database
# already holds: the scheduled cycle skips the pull and re-runs detection.
DHIS2_BASE_URL=""
DHIS2_USERNAME=""
DHIS2_PASSWORD=""

# Shared secret for POST /api/jobs/ingest, the scheduled monthly cycle.
CRON_SECRET=""

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The address people actually reach the app at. On Vercel this is worked out
# from the deployment, so set it only for a custom domain.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The first administrator, for `npm run db:bootstrap` against a fresh
# database. Needed once; every other account is made from the app.
# ADMIN_NAME=""
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
