# Postgres connection used by Prisma and the Better Auth adapter.
DATABASE_URL="postgresql://user:password@localhost:5432/sentinel"

# Password every seeded account starts with (default: password123).
# SEED_PASSWORD=""

# DHIS2. Without these the app runs on whatever case counts the database
# already holds: the scheduled cycle skips the pull and re-runs detection.
DHIS2_BASE_URL=""
DHIS2_USERNAME=""
DHIS2_PASSWORD=""

# Shared secret for POST /api/jobs/ingest, the scheduled monthly cycle.
CRON_SECRET=""

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
